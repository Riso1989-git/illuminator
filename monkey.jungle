project.manifest = manifest.xml

# Compile only ./source. Without this, stale copies of the sources that a
# previous optimized build left in bin/ get compiled too ("Redefinition of ...").
base.sourcePath = source

# Resources are selected automatically by folder name: every product gets
# resources/ plus the resources-round-WxH folder matching its screen.
#   resources-round-454x454  approachs7047mm d2mach2 descentmk351mm epix2pro51mm fenix847mm
#                            fenix8pro47mm fr57047mm fr965 fr970 venu3 venu445mm
#   resources-round-416x416  d2airx10 d2mach1 epix2 epix2pro47mm fenix843mm fenixe fr265
#                            instinct3amoled50mm venu2 venu2plus
#   resources-round-390x390  approachs7042mm descentg2 descentmk343mm epix2pro42mm fr165 fr165m
#                            fr57042mm instinct3amoled45mm marq2 marq2aviator venu3s venu441mm
#                            vivoactive5 vivoactive6
# (sizes taken from the SDK device files; the explicit <device>.resourcePath lines that used
#  to be here added the same folder twice and caused "already exists in the resource path"
#  warnings - several commented-out ones also pointed 390x390 devices at the 416 folder)
